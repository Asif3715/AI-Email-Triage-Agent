# Frontend — copy to frontend/.env (never commit frontend/.env)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Reference only: Apps Script does not read .env files at runtime.
# Do NOT prefix GROQ_API_KEY with VITE_ or it could be bundled into the client build.
# Copy these into Apps Script Script Properties.
GROQ_API_KEY=your_groq_api_key
SPREADSHEET_ID=your_google_sheet_id
HUMAN_SUPPORT_EMAIL=human-support@yourdomain.com
POLL_LOOKBACK_MINUTES=10
